# ==============================================================================
# Android & Windows Gemini Automation Agent Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your environment-specific settings.
# Do NOT commit '.env' containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini API & Model Configuration
# ------------------------------------------------------------------------------
# Primary Google Gemini API key obtained from Google AI Studio:
# https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Active Gemini model identifier. Recommended models:
# - gemini-2.5-flash       : Fast, cost-efficient, optimal for real-time mobile automation
# - gemini-3.5-flash-lite  : Ultra-lightweight & high throughput
# - gemini-2.5-pro         : Deep reasoning for complex multi-app workflows
GEMINI_MODEL=gemini-2.5-flash

# Model sampling temperature (0.0 to 2.0).
# 0.0 is deterministic and recommended for precise UI tool calling.
GEMINI_TEMPERATURE=0.0

# ------------------------------------------------------------------------------
# 2. Target Platform Selection
# ------------------------------------------------------------------------------
# Primary target platform: 'android' or 'windows'
# Default: android
TARGET_PLATFORM=android

# ------------------------------------------------------------------------------
# 3. Android Wireless ADB Connection Parameters
# ------------------------------------------------------------------------------
# Target Android device local IP address (ensure PC and phone are on the same Wi-Fi)
ADB_DEVICE_IP=192.168.1.100

# Target Android device wireless debugging port (displayed in Developer Options -> Wireless Debugging)
ADB_DEVICE_PORT=5555

# Wireless pairing port and code (Android 11+ pairing dialog under 'Pair device with pairing code')
# Only needed when pairing a new device for the first time
ADB_PAIR_PORT=37123
ADB_PAIR_CODE=123456

# Timeout for ADB network connections and shell commands (in seconds)
ADB_TIMEOUT_SECONDS=10.0

# ------------------------------------------------------------------------------
# 4. Agent Execution & Safety Guardrails
# ------------------------------------------------------------------------------
# Maximum decision turns/steps allowed for a single task before forcing termination
MAX_AGENT_STEPS=20

# Inter-action delay (in seconds) between executing commands to allow UI animations to settle
ACTION_DELAY_SECONDS=1.0

# Number of consecutive identical actions/states triggering infinite loop recovery warnings
LOOP_DETECTION_THRESHOLD=3

# Number of recent conversation turns preserved in rolling prompt context history
CONTEXT_HISTORY_MAX_TURNS=5

# ------------------------------------------------------------------------------
# 5. Rate Limiting & Resilience Parameters
# ------------------------------------------------------------------------------
# Maximum retries on Gemini API rate limit / 429 ResourceExhausted errors
GEMINI_MAX_RETRIES=5

# Base backoff delay in seconds for exponential rate limit retries
GEMINI_RETRY_BASE_DELAY=2.0

# Maximum wait time in seconds for a single API retry attempt
GEMINI_RETRY_MAX_DELAY=30.0

# ------------------------------------------------------------------------------
# 6. Logging, Console & Diagnostic Output
# ------------------------------------------------------------------------------
# Logging verbosity level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable Rich-formatted exception tracebacks and colorful console renderers
RICH_TRACEBACKS=True
